# Railway Production Environment Configuration
# This file documents required environment variables for Railway deployment

# CRITICAL: Set these in Railway dashboard (railway.app)

# Node Environment
NODE_ENV=production

# Server Port (Railway will provide this automatically)
# PORT=3000

# Storage Configuration
STORAGE_TYPE=database

# Database Configuration (from Railway Postgres addon or Neon.tech)
# Railway Format: postgresql://user:password@host:port/database
# Neon.tech Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=<your-railway-database-url-here>

# Token Encryption (MUST be 64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_MASTER_KEY=<generate-with-crypto-random-bytes>

# JWT Secrets (MUST be 128 hex characters = 64 bytes each)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<generate-with-crypto-random-bytes>
JWT_REFRESH_SECRET=<generate-with-crypto-random-bytes>

# Application URL (your Railway app URL)
APP_URL=https://your-app.railway.app

# CORS Configuration (your Railway app URL)
ALLOWED_ORIGINS=https://your-app.railway.app

# Email Configuration (Resend API for production)
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM=noreply@yourdomain.com

# Optional: Database Connection Tuning
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=30000
