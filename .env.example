# Contao Manager API Configuration

# Token encryption master key (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_MASTER_KEY=your_32_byte_hex_key_here_64_characters_long_replace_this_value

# Server configuration
PORT=3000
NODE_ENV=development

# Storage Configuration
# Storage type: json_file (default), database (Phase 1)
STORAGE_TYPE=json_file

# JSON File Storage Configuration (default)
DATA_DIR=./data

# Database Storage Configuration (Phase 1 - Neon.tech PostgreSQL)
# Get your DATABASE_URL from Neon.tech dashboard
# Format: postgresql://username:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/contao_manager?sslmode=require

# Database connection pooling (optional - Prisma defaults work well)
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=30000

# Authentication Configuration (Better Auth)
# Session secret for signing cookies (sessions persist across server restarts)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here_replace_this_value

# Application URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# WebAuthn/Passkey Configuration (for production, use your actual domain)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Contao Update & Backup Service

# TOTP Configuration (optional - name shown in authenticator apps)
TOTP_ISSUER=Contao Manager

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration (optional - for email verification and password reset)
# RECOMMENDED: Use Resend for production (Railway compatible, no SMTP blocking)
# Get your API key from https://resend.com/api-keys (Free tier: 3,000 emails/month)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=onboarding@resend.dev
#
# ALTERNATIVE: Use SMTP for development/self-hosted (blocked on Railway)
# Note: Railway blocks outbound SMTP on ports 25, 465, 587
# For SSL (port 465):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM=noreply@contao-manager.com
#
# For STARTTLS (port 587):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM=noreply@contao-manager.com
