# Contao Manager API Configuration

# Token encryption master key (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_MASTER_KEY=your_32_byte_hex_key_here_64_characters_long_replace_this_value

# Server configuration
PORT=3000
NODE_ENV=development

# Storage Configuration
# Storage type: json_file (default), database (Phase 1)
STORAGE_TYPE=json_file

# JSON File Storage Configuration (default)
DATA_DIR=./data

# Database Storage Configuration (Phase 1 - Neon.tech PostgreSQL)
# Get your DATABASE_URL from Neon.tech dashboard
# Format: postgresql://username:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/contao_manager?sslmode=require

# Database connection pooling (optional - Prisma defaults work well)
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=30000

# Authentication Configuration (Phase 2 - User Authentication)
# JWT secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_here_128_characters_long_replace_this_value
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_128_characters_long_replace_this_value

# Application URL (for email verification and password reset links)
APP_URL=http://localhost:3000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration (optional - for email verification and password reset)
# For SSL (port 465):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM=noreply@contao-manager.com
#
# For STARTTLS (port 587):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM=noreply@contao-manager.com
