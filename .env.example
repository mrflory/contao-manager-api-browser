# Contao Manager API Configuration

# Token encryption master key (64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_MASTER_KEY=your_32_byte_hex_key_here_64_characters_long_replace_this_value

# Server configuration
PORT=3000
NODE_ENV=development

# Storage Configuration
# Storage type: json_file (default), browser (client-side), database (Phase 1)
STORAGE_TYPE=json_file

# JSON File Storage Configuration (default)
DATA_DIR=./data

# Browser Storage Configuration (client-side only)
STORAGE_NAMESPACE=contao-manager

# Database Storage Configuration (Phase 1)
# DATABASE_URL=postgresql://username:password@localhost:5432/contao_manager
# DATABASE_TABLE=site_configs

# Storage Migration and Backup Options
# ALLOW_STORAGE_MIGRATION=true
# BACKUP_BEFORE_MIGRATION=true