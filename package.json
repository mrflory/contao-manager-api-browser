{
  "name": "contao-update-backup-service",
  "version": "1.0.0",
  "description": "Automated Contao updates with comprehensive backup and restore functionality",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrflory/contao-manager-api-browser.git"
  },
  "homepage": "https://github.com/mrflory/contao-manager-api-browser#readme",
  "bugs": {
    "url": "https://github.com/mrflory/contao-manager-api-browser/issues"
  },
  "scripts": {
    "start": "NODE_ENV=production node dist-server/server.js",
    "dev": "nodemon --exec \"ts-node --project tsconfig.backend.json src/server.ts\" --ignore 'data/*'",
    "dev:stable": "ts-node src/server.ts",
    "dev:react": "vite",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:react\"",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.backend.json && npm run postbuild:server",
    "postbuild:server": "mkdir -p dist-server/generated && cp -r src/generated/prisma dist-server/generated/",
    "build:all": "npm run build:server && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:react19-compat": "node scripts/test-react19-compat.js",
    "test:chakra-v3-compat": "node scripts/test-chakra-v3-compat.js",
    "test:build": "npm run build && npm run preview",
    "mock:server": "ts-node --project tsconfig.mock.json src/test/mockServer/start.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "migrate:database": "ts-node --project tsconfig.backend.json src/scripts/migrate-database.ts",
    "seed:database": "ts-node --project tsconfig.backend.json src/scripts/seed-database.ts",
    "seed:database:append": "ts-node --project tsconfig.backend.json src/scripts/seed-database.ts --append"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.30.0",
    "@emotion/react": "^11.14.0",
    "@prisma/client": "^6.16.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.0.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "prisma": "^6.16.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.6.2",
    "resend": "^6.2.2",
    "shiki": "^3.9.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "keywords": [
    "contao",
    "manager",
    "api",
    "browser",
    "dashboard",
    "multi-site",
    "oauth",
    "cms",
    "monitoring"
  ],
  "author": "Florian Stallmann <florian@stallmann.me>",
  "license": "MIT"
}
