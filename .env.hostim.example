# Hostim production environment example

NODE_ENV=production
STORAGE_TYPE=database
DATABASE_URL=postgresql://username:password@host:5432/database

# 64 hex chars
TOKEN_MASTER_KEY=replace_with_64_hex_characters

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_strong_secret

APP_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example

WEBAUTHN_RP_ID=your-domain.example
WEBAUTHN_RP_NAME=Contao Update & Backup Service
TOTP_ISSUER=Contao Manager

ALLOWED_ORIGINS=https://your-domain.example

# Optional email
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=noreply@your-domain.example
